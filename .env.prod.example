POSTGRES_DB=hatch
POSTGRES_USER=hatch
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql+psycopg2://hatch:replace-with-a-strong-password@db:5432/hatch
REDIS_URL=redis://redis:6379/0
CORS_ALLOW_ORIGINS=https://your-name.duckdns.org
BACKEND_PORT=8000
NGINX_PORT=80
DOMAIN=your-name.duckdns.org
HAPROXY_STATS_USER=replace-with-admin-user
HAPROXY_STATS_PASSWORD=replace-with-a-strong-password
GRAFANA_USER=replace-with-admin-user
GRAFANA_PASSWORD=replace-with-a-strong-password

BACKUP_RETENTION_DAYS=7
REMOTE_BACKUP_ENABLED=false
REMOTE_HOST=
REMOTE_USER=
REMOTE_PATH=
REMOTE_SSH_KEY=
